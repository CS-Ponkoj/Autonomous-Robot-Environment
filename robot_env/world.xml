<!--
  World: a closed 6 m x 6 m room with static obstacles and a
  two-wheeled (differential-drive) robot. Units: meters, kilograms, seconds.

  Geom groups:
    0 = solid (walls, obstacles, robot)  - seen by the lidar
    2 = visual only (markers, stripes)    - ignored by the lidar, never collides
-->
<mujoco model="robot_arena">
  <compiler angle="degree"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.45 0.45 0.45" specular="0.1 0.1 0.1"/>
    <!-- Near/far clip planes are fractions of the model extent (about 12 m). znear 0.001
         (about 1 cm) stops cameras from seeing through walls they are close to. -->
    <map znear="0.001" zfar="3"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.55 0.7 0.9" rgb2="0.1 0.15 0.25" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.82 0.82 0.80" rgb2="0.68 0.68 0.66" width="512" height="512"/>
    <material name="floor" texture="grid" texrepeat="12 12" reflectance="0.05"/>
    <material name="wall" rgba="0.78 0.74 0.66 1"/>
    <material name="robot_body" rgba="0.15 0.35 0.75 1"/>
    <material name="rubber" rgba="0.08 0.08 0.08 1"/>
  </asset>

  <default>
    <default class="visual">
      <geom contype="0" conaffinity="0" group="2" mass="0"/>
    </default>
  </default>

  <worldbody>
    <light name="sun" pos="1 -1 6" dir="-0.2 0.2 -1" directional="true" castshadow="true" diffuse="0.6 0.6 0.6"/>
    <geom name="floor" type="plane" size="4 4 0.1" material="floor"/>

    <!-- Room walls: inner faces at x = +/-3 m and y = +/-3 m -->
    <geom name="wall_north" type="box" pos="0 3.05 0.25" size="3.1 0.05 0.25" material="wall"/>
    <geom name="wall_south" type="box" pos="0 -3.05 0.25" size="3.1 0.05 0.25" material="wall"/>
    <geom name="wall_east" type="box" pos="3.05 0 0.25" size="0.05 3.1 0.25" material="wall"/>
    <geom name="wall_west" type="box" pos="-3.05 0 0.25" size="0.05 3.1 0.25" material="wall"/>

    <!-- OBSTACLES: static, each a separate named geom.
         All are taller than the lidar plane (0.135 m) so the lidar can see them. -->
    <geom name="wall_inner" type="box" pos="0 -1.8 0.25" size="1.0 0.05 0.25" material="wall"/>
    <geom name="box_red" type="box" pos="1.2 1.0 0.15" size="0.25 0.25 0.15" rgba="0.85 0.2 0.2 1"/>
    <geom name="box_blue" type="box" pos="-1.5 -0.8 0.2" size="0.4 0.15 0.2" euler="0 0 30" rgba="0.2 0.4 0.9 1"/>
    <geom name="box_orange" type="box" pos="2.2 2.0 0.15" size="0.2 0.3 0.15" rgba="0.95 0.55 0.1 1"/>
    <geom name="pillar_green" type="cylinder" pos="-1.0 1.6 0.2" size="0.2 0.2" rgba="0.2 0.7 0.3 1"/>
    <geom name="pillar_yellow" type="cylinder" pos="1.8 -1.6 0.25" size="0.15 0.25" rgba="0.95 0.85 0.2 1"/>
    <!-- /OBSTACLES -->

    <!-- Goal marker: moved at every reset; visual only -->
    <body name="goal" mocap="true" pos="2 2 0">
      <geom name="goal_disc" class="visual" type="cylinder" size="0.3 0.002" pos="0 0 0.002" rgba="0.1 0.85 0.3 0.35"/>
      <geom name="goal_pole" class="visual" type="cylinder" size="0.015 0.25" pos="0 0 0.25" rgba="0.1 0.85 0.3 1"/>
      <geom name="goal_flag" class="visual" type="box" size="0.06 0.004 0.04" pos="0.06 0 0.46" rgba="0.1 0.85 0.3 1"/>
    </body>

    <!-- The robot. Body origin = midpoint between the wheel axles, 5 cm above the floor. -->
    <body name="robot" pos="0 0 0.05">
      <freejoint name="robot_root"/>
      <geom name="chassis" type="box" pos="0 0 0.03" size="0.15 0.10 0.035" mass="2.0" material="robot_body"/>
      <!-- Frictionless ball casters keep the robot level. They sit 1 mm above the
           floor so the wheels carry the weight; if the casters touch the floor,
           they take the load and the wheels slip (found in the step 5 check). -->
      <geom name="front_caster" type="sphere" pos="0.11 0 -0.024" size="0.025" mass="0.05" condim="1" rgba="0.3 0.3 0.3 1"/>
      <geom name="rear_caster" type="sphere" pos="-0.11 0 -0.024" size="0.025" mass="0.05" condim="1" rgba="0.3 0.3 0.3 1"/>
      <!-- Lidar housing on top; rays start at lidar_site (0.135 m above the floor) -->
      <geom name="lidar_housing" type="cylinder" pos="0 0 0.075" size="0.035 0.01" mass="0.1" rgba="0.1 0.1 0.1 1"/>
      <site name="lidar_site" pos="0 0 0.085" size="0.005"/>
      <!-- Yellow marker shows which way is forward -->
      <geom name="front_marker" class="visual" type="box" pos="0.12 0 0.0675" size="0.02 0.05 0.003" rgba="1 0.8 0 1"/>
      <!-- Forward-looking camera: what the robot sees -->
      <camera name="robot_cam" pos="0.15 0 0.09" xyaxes="0 -1 0 0 0 1" fovy="75"/>

      <body name="left_wheel" pos="0 0.12 0">
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0" damping="0.001"/>
        <geom name="left_tire" type="cylinder" size="0.05 0.015" zaxis="0 1 0" mass="0.2" friction="1.2 0.005 0.0001" material="rubber"/>
        <geom class="visual" type="box" size="0.045 0.016 0.008" rgba="0.9 0.9 0.9 1"/>
      </body>
      <body name="right_wheel" pos="0 -0.12 0">
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0" damping="0.001"/>
        <geom name="right_tire" type="cylinder" size="0.05 0.015" zaxis="0 1 0" mass="0.2" friction="1.2 0.005 0.0001" material="rubber"/>
        <geom class="visual" type="box" size="0.045 0.016 0.008" rgba="0.9 0.9 0.9 1"/>
      </body>
    </body>
  </worldbody>

  <!-- Wheel motors: each drives its wheel toward a target speed (rad/s).
       Gains are tuned in the step 5 motion check. -->
  <actuator>
    <velocity name="left_motor" joint="left_wheel_joint" kv="2.0" ctrlrange="-20 20" forcerange="-3 3"/>
    <velocity name="right_motor" joint="right_wheel_joint" kv="2.0" ctrlrange="-20 20" forcerange="-3 3"/>
  </actuator>
</mujoco>
